# ── Copy this file to .env and fill in your values ───────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cti
POSTGRES_PASSWORD=ctipassword_change_me
POSTGRES_DB=ctidb

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── LLM — OpenAI (primary for report generation) ─────────────────────────────
# Get your key at platform.openai.com
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
MAX_REPORT_TOKENS=4096

# ── LLM — Gemini (fallback if OpenAI is unavailable) ─────────────────────────
# Get free key at aistudio.google.com
GEMINI_API_KEY=

# ── LLM — Anthropic (optional, kept for compatibility) ───────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ── NVD API — Free key from nvd.nist.gov (increases rate limit 5x) ──────────
# Without key: 5 req/30s   |   With key: 50 req/30s
NVD_API_KEY=

# ── Feed settings ─────────────────────────────────────────────────────────────
MIN_SEVERITY=HIGH
INITIAL_LOOKBACK_DAYS=3

# ── Matching thresholds ───────────────────────────────────────────────────────
# Cosine similarity score (0.0–1.0) above which an asset is considered a match
# 0.55 = good balance of precision/recall for security product names
# Increase to 0.65+ for fewer false positives
# Decrease to 0.45 for broader matching (more alerts)
SEMANTIC_MATCH_THRESHOLD=0.55

# ── RAG report generation ────────────────────────────────────────────────────
# How many sample report examples to inject into the prompt (1–5)
RAG_NUM_EXAMPLES=3
# Minimum similarity to use an example (0.0–1.0)
RAG_MIN_SIMILARITY=0.4

# ── SMTP (Phase 2 — email sending) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CTI Security Team <your-email@gmail.com>
